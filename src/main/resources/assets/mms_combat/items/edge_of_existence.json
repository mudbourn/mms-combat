{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {
        "when": [
          "gui",
          "ground",
          "fixed"
        ],
        "model": {
          "type": "minecraft:range_dispatch",
          "property": "mms_combat:counter",
          "component": "mms_combat:ability_tick",
          "entries": [
            {
              "threshold": 1,
              "model": {
                "type": "minecraft:model",
                "model": "mms_combat:item/edge_of_existence_active_inventory"
              }
            }
          ],
          "fallback": {
            "type": "minecraft:model",
            "model": "mms_combat:item/edge_of_existence_inactive_inventory"
          }
        }
      }
    ],
    "fallback": {
      "type": "minecraft:range_dispatch",
      "property": "mms_combat:counter",
      "component": "mms_combat:ability_tick",
      "entries": [
        {
          "threshold": 1,
          "model": {
            "type": "mms_render_common:geo",
            "base": "mms_combat:item/edge_of_existence_held",
            "geo": "mms_combat:geo/item/edge_of_existence.geo.json",
            "texture": "mms_combat:textures/item/edge_of_existence/edge_of_existence_1.png"
          }
        }
      ],
      "fallback": {
        "type": "mms_render_common:geo",
        "base": "mms_combat:item/edge_of_existence_held",
        "geo": "mms_combat:geo/item/edge_of_existence.geo.json",
        "texture": "mms_combat:textures/item/edge_of_existence/edge_of_existence_0.png"
      }
    }
  },
  "hand_animation_on_swap": false
}
